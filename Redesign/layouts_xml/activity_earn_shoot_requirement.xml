<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_weak"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:background="@color/bg_weak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/earn_requirement_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/earn_req_header"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/requirementCardContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/earn_requirement_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/earn_req_section_settle"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settleCard"
                android:background="@drawable/bg_earn_card_outlined"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"/>
            <TextView
                android:textSize="17dp"
                android:textStyle="bold"
                android:textColor="@color/earn_requirement_title"
                android:id="@+id/tvPrivacyEntry"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/earn_req_privacy_entry"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/earn_requirement_privacy_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/earn_req_privacy_summary"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/privacyCard"
                android:background="@drawable/bg_earn_card_outlined"
                android:paddingTop="@dimen/dp_20"
                android:paddingBottom="@dimen/dp_20"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/bottomBar"
        android:background="@color/bg_white"
        android:paddingTop="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="17dp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:gravity="center"
            android:id="@+id/btnKnown"
            android:background="@drawable/bg_earn_primary_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/earn_task_go_shoot"
            android:includeFontPadding="false"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
