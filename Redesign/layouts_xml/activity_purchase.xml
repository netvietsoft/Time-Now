<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clRoot"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/bgGradientView"
        android:background="@drawable/bg_336e78ff_to_transparent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/clBottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_20"
        android:src="@drawable/close_dark"
        android:layout_marginEnd="@dimen/dp_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/dp_22"
        android:textStyle="bold"
        android:textColor="@color/text_ultrastrong"
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/i_timemark_plans"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivClose"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clChangePlan"
        android:background="@drawable/bg_radius_6_white"
        android:padding="@dimen/dp_2"
        android:layout_width="@dimen/dp_220"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/textSize16"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvPlanPro"
            android:background="@drawable/bg_radius_5_7a6eff"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/i_plus"
            app:layout_constraintEnd_toStartOf="@+id/tvPlanBusiness"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/textSize16"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvPlanBusiness"
            android:background="@drawable/bg_radius_5_0070f4"
            android:layout_width="@dimen/dp_0"
            android:layout_height="match_parent"
            android:text="@string/i_business"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tvPlanPro"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvValues"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_32"
        app:layout_constraintBottom_toTopOf="@+id/clBottom"
        app:layout_constraintTop_toBottomOf="@+id/clChangePlan"/>
    <View
        android:background="@drawable/shadow_top"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/clBottom"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clBottom"
        android:background="@color/white"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dp_157"
        android:elevation="0dp"
        android:paddingHorizontal="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/text_ultrastrong"
            android:gravity="center"
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:lineSpacingExtra="@dimen/dp_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/text_ultrastrong"
            android:gravity="center"
            android:id="@+id/tvPriceDes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:lineSpacingExtra="@dimen/dp_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvPrice"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_18"
            android:textStyle="bold"
            android:textColor="@color/text_ultrastrong"
            android:gravity="center"
            android:id="@+id/tvBusinessPrice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/dp_14"
            android:textColor="@color/text_ultrastrong"
            android:gravity="center"
            android:id="@+id/tvBusinessFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:lineSpacingExtra="@dimen/dp_3"
            android:layout_marginHorizontal="@dimen/dp_28"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvBusinessPrice"
            app:layout_goneMarginTop="@dimen/dp_20"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clProButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/tvPriceDes">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize17"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvTryItFree"
                android:background="@drawable/bg_r8_purple"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:text="@string/i_loading"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginTop="@dimen/dp_120"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clPlanSelectorContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/llPlanCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clPlanYearCard"
                    android:background="@drawable/bg_plan_card_selected"
                    android:padding="@dimen/dp_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/dp_68">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPlanYearRadio"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_radio_selected"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:id="@+id/llPaymentIcons"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPaymentIcon1"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivPaymentIcon2"
                            android:visibility="gone"
                            android:layout_width="40dp"
                            android:layout_height="26dp"
                            android:scaleType="fitCenter"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/llPlanYearText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/llPaymentIcons"
                        app:layout_constraintStart_toEndOf="@+id/ivPlanYearRadio"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/textSize14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_ultrastrong"
                            android:id="@+id/tvPlanYearTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/i_pay_annually"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/text_strong"
                            android:id="@+id/tvPlanYearSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_6"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clPlanMonthCard"
                    android:background="@drawable/bg_plan_card_unselected"
                    android:padding="@dimen/dp_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:minHeight="@dimen/dp_68">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivPlanMonthRadio"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_radio_unselected"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/llPlanMonthText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ivPlanMonthRadio"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/textSize14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_ultrastrong"
                            android:id="@+id/tvPlanMonthTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/i_pay_monthly"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="12sp"
                            android:textColor="@color/text_strong"
                            android:id="@+id/tvPlanMonthSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_6"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize14sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvSavePercent"
                android:background="@drawable/bg_save_badge"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_25"
                android:layout_marginTop="@dimen/dp_10"
                android:paddingHorizontal="@dimen/dp_7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clDualSubscribe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                app:layout_constraintTop_toBottomOf="@+id/llPlanCards">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/textSize17"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/tvTryItFreeDual"
                    android:background="@drawable/bg_r8_purple"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_48"
                    android:text="@string/i_vip_subscribe_now"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBusinessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            app:layout_constraintTop_toBottomOf="@+id/tvBusinessFree">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize16"
                android:textColor="@color/text_ultrastrong"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvBusinessTeamName"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:maxLines="1"
                android:drawablePadding="6dp"
                android:drawableEnd="@drawable/ic_arrow_down_16_text_ultrastrong"
                android:fontFamily="sans-serif-medium"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize17"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvTryBusiness"
                android:background="@drawable/bg_radius_5_0070f4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBusinessTeamName"
                app:layout_goneMarginTop="0dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clSubscribedState"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/dp_14"
                android:textColor="@color/text_ultrastrong"
                android:gravity="center"
                android:id="@+id/tvPurchasedBy"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize17"
                android:textStyle="bold"
                android:textColor="@color/text_ultrastrong"
                android:gravity="center"
                android:id="@+id/tvCurrentPlan"
                android:background="@drawable/bg_current_plan_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/i_current_plan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvPurchasedBy"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clBusinessSubscribedState"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize16"
                android:textColor="@color/text_ultrastrong"
                android:ellipsize="end"
                android:gravity="start|center_vertical"
                android:id="@+id/tvBusinessPurchasedBy"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:maxLines="1"
                android:drawablePadding="6dp"
                android:drawableEnd="@drawable/ic_arrow_down_16_text_ultrastrong"
                android:fontFamily="sans-serif-medium"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize17"
                android:textStyle="bold"
                android:textColor="@color/text_ultrastrong"
                android:gravity="center"
                android:id="@+id/tvBusinessCurrentPlan"
                android:background="@drawable/bg_current_plan_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_48"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/i_current_plan"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvBusinessPurchasedBy"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="clProButton,clBusinessButton,clPlanSelectorContainer,clSubscribedState,clBusinessSubscribedState"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/textSize14sp"
            android:textColor="@color/color_pro_7a6eff"
            android:gravity="center"
            android:id="@+id/tvRestore"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/i_restore_purchases"
            android:includeFontPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
