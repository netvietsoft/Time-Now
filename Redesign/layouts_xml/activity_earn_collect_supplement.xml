<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/earn_ios_bg_weak"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/scroll_content"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="56dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/earn_supplement_card_bg"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">
                <TextView
                    android:textSize="17dp"
                    android:textColor="@color/earn_ios_text_ultrastrong"
                    android:id="@+id/tv_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/earn_ios_text_weak"
                    android:id="@+id/tv_status_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/player_card"
                android:background="@drawable/earn_supplement_card_bg"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp">
                <FrameLayout
                    android:id="@+id/video_container"
                    android:background="@drawable/earn_supplement_video_bg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <SurfaceView
                        android:layout_gravity="center"
                        android:id="@+id/surface_player"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/btn_play_pause"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="center"
                        android:contentDescription="@string/earn_supplement_play_pause"/>
                    <TextView
                        android:textSize="12dp"
                        android:textColor="#ffffff"
                        android:layout_gravity="end|bottom"
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:includeFontPadding="false"/>
                </FrameLayout>
                <com.xhey.xcamera.earn.ui.view.EarnSpeechTimelineView
                    android:id="@+id/timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:textSize="11dp"
                    android:textColor="@color/earn_ios_text_ultraweak"
                    android:ellipsize="end"
                    android:id="@+id/tv_timeline_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/earn_supplement_timeline_legend"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/annotation_input_row"
                    android:background="@drawable/earn_supplement_input_bg"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="12dp">
                    <ImageView
                        android:id="@+id/btn_annotation_mic"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/earn_supplement_mic"/>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp">
                        <EditText
                            android:textSize="16dp"
                            android:textColor="@color/earn_ios_text_ultrastrong"
                            android:textColorHint="@color/earn_ios_text_ultraweak"
                            android:id="@+id/et_annotation"
                            android:background="@null"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="@string/earn_supplement_annotation_hint"
                            android:maxLines="1"
                            android:inputType="text"
                            android:imeOptions="actionDone"/>
                        <com.xhey.xcamera.earn.ui.view.EarnLiveTranscriptView
                            android:id="@+id/live_annotation"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                    </FrameLayout>
                    <TextView
                        android:textSize="16dp"
                        android:textColor="@color/earn_ios_text_highlight"
                        android:gravity="center"
                        android:id="@+id/btn_add_annotation"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="48dp"
                        android:text="@string/earn_supplement_add"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/earn_supplement_card_bg"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="16dp">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/earn_ios_text_ultrastrong"
                    android:id="@+id/tv_note_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/earn_ios_text_ultraweak"
                    android:id="@+id/tv_note_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:includeFontPadding="false"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/annotation_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/earn_ios_text_highlight"
                android:id="@+id/tv_tier_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/earn_supplement_tier_hint"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:layout_marginHorizontal="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/question_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:scaleType="center"
        android:contentDescription="@string/earn_supplement_back"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_bar_hairline"
        android:background="@color/earn_ios_border_weak"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_bar"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_bar"
        android:background="#ffffff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="11dp"
                android:textColor="@color/earn_ios_text_ultraweak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earn_supplement_estimate_label"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="22dp"
                android:textColor="@color/earn_ios_text_highlight"
                android:id="@+id/tv_estimate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/earn_ios_text_weak"
            android:gravity="center"
            android:id="@+id/btn_skip"
            android:background="@drawable/earn_supplement_skip_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/earn_supplement_skip"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="16dp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_upload"
            android:background="@drawable/earn_supplement_primary_bg"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/earn_supplement_upload"
            android:includeFontPadding="false"
            android:layout_weight="1.4"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
