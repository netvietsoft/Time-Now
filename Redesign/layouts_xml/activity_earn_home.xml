<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_weak"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:background="@color/bg_weak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:leftAction="close"
        app:rightActionStyle="text"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/tabContainer"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/text_ultrastrong"
            android:id="@+id/tvTabMakeMoney"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:text="@string/earn_tab_make_money"
            android:includeFontPadding="false"/>
        <FrameLayout
            android:clipChildren="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_5"
            android:layout_marginStart="18dp">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/text_ultraweak"
                android:id="@+id/tvTabMyShoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/earn_tab_my_shoot"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/text_white"
                android:gravity="center"
                android:layout_gravity="end|top"
                android:id="@+id/tvMyShootBadge"
                android:background="@drawable/bg_earn_badge"
                android:visibility="gone"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="-4dp"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_marginEnd="-14dp"/>
        </FrameLayout>
    </LinearLayout>
    <View
        android:id="@+id/tabIndicator"
        android:background="@drawable/bg_earn_tab_indicator"
        android:layout_width="24dp"
        android:layout_height="3dp"
        android:layout_marginBottom="@dimen/dp_9"
        app:layout_constraintBottom_toBottomOf="@+id/tabContainer"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
