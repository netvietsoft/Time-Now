<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/btnContinue">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/i_create_your_team"/>
        <com.xhey.xcamera.uikit.view.AutoDirectionTextView
            android:textSize="@dimen/textSize16"
            android:textColor="@color/text_weak"
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/i_have_not_create_join_team"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_radius_5_ebebed_real"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.xhey.xcamera.uikit.view.AutoDirectionEditTextView
                android:textSize="@dimen/textSize17"
                android:textColor="@color/black"
                android:textColorHint="@color/text_weak"
                android:id="@+id/etTeamName"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/i_your_team_name"
                android:maxLength="40"
                android:inputType="textMultiLine"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_marginVertical="@dimen/dp_11"
                android:paddingHorizontal="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tvCharCount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/textSize17"
                android:textColor="@color/text_weak"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/tvCharCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/40"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <com.xhey.xcamera.uikit.btn.XHeyButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_240"
        android:alpha="0.5"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/i_continue_next_step"/>
</androidx.constraintlayout.widget.ConstraintLayout>
