<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/earn_onboarding_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:background="@color/earn_onboarding_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/stepProgress"
        android:layout_width="0dp"
        android:layout_height="9dp"
        android:layout_marginTop="@dimen/dp_8"
        android:max="4"
        android:progressDrawable="@drawable/bg_earn_onboarding_progress"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="27dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/stepScrollView"
        android:paddingBottom="@dimen/dp_16"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="43dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stepProgress">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/stepVideo"
                layout="@layout/view_earn_onboarding_video"/>
            <include
                android:id="@+id/stepHarness"
                layout="@layout/view_earn_onboarding_harness"/>
            <include
                android:id="@+id/stepQuiz"
                layout="@layout/view_earn_onboarding_quiz"/>
            <include
                android:id="@+id/stepSpeakQuiz"
                layout="@layout/view_earn_onboarding_speak_quiz"/>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
