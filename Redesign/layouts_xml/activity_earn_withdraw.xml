<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/earn_ios_bg_weak"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/formContainer"
            android:paddingTop="@dimen/dp_12"
            android:paddingBottom="@dimen/dp_24"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/dp_16"
            android:paddingEnd="@dimen/dp_16">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_earn_card"
                android:padding="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_ultrastrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/earn_withdraw_amount_title"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/dp_12">
                    <TextView
                        android:textSize="24dp"
                        android:textColor="@color/text_ultrastrong"
                        android:id="@+id/tvCurrencySymbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:fontFamily="sans-serif-medium"/>
                    <EditText
                        android:textSize="28dp"
                        android:textColor="@color/text_ultrastrong"
                        android:textColorHint="@color/earn_ios_text_ultraweak"
                        android:id="@+id/etAmount"
                        android:background="@null"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="@string/earn_withdraw_amount_placeholder"
                        android:singleLine="true"
                        android:includeFontPadding="false"
                        android:layout_weight="1"
                        android:inputType="numberDecimal"
                        android:imeOptions="actionDone"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginStart="@dimen/dp_6"
                        android:importantForAutofill="no"/>
                    <TextView
                        android:textSize="15dp"
                        android:textColor="@color/earn_primary"
                        android:gravity="center"
                        android:id="@+id/tvAll"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/earn_withdraw_all"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/dp_12"/>
                </LinearLayout>
                <View
                    android:background="@color/earn_border_weak"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="@dimen/dp_8"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/earn_ios_text_ultraweak"
                    android:id="@+id/tvAmountHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_earn_card"
                android:padding="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/text_ultrastrong"
                    android:id="@+id/tvAccountCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"/>
                <com.xhey.xcamera.earn.ui.view.EarnSegmentedControl
                    android:id="@+id/segMethod"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="@dimen/dp_12"/>
                <com.xhey.xcamera.earn.ui.view.EarnSegmentedControl
                    android:id="@+id/segPixType"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="@dimen/dp_12"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/bankRow"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="@dimen/dp_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13dp"
                        android:textColor="@color/earn_ios_text_ultraweak"
                        android:id="@+id/tvBankTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_6"
                        android:minHeight="28dp">
                        <TextView
                            android:textSize="16dp"
                            android:id="@+id/tvBankValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <ImageView
                            android:id="@+id/ivBankChevron"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_earn_chevron_right"
                            android:importantForAccessibility="no"/>
                    </LinearLayout>
                    <View
                        android:background="@color/earn_border_weak"
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginTop="@dimen/dp_6"/>
                </LinearLayout>
                <include
                    android:id="@+id/rowAccount"
                    layout="@layout/view_earn_withdraw_input_row"/>
                <include
                    android:id="@+id/rowName"
                    layout="@layout/view_earn_withdraw_input_row"/>
                <include
                    android:id="@+id/rowPhone"
                    layout="@layout/view_earn_withdraw_input_row"/>
                <include
                    android:id="@+id/rowEmail"
                    layout="@layout/view_earn_withdraw_input_row"/>
            </LinearLayout>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/earn_ios_text_ultraweak"
                android:id="@+id/tvNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:text="@string/earn_withdraw_note"
                android:lineSpacingExtra="2dp"/>
            <TextView
                android:textSize="13dp"
                android:textColor="@color/earn_primary"
                android:id="@+id/tvPolicyLink"
                android:paddingTop="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:background="@color/earn_border_weak"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <FrameLayout
        android:background="@color/bg_white"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="@dimen/dp_16">
        <TextView
            android:enabled="false"
            android:textSize="16dp"
            android:textColor="@color/text_white"
            android:gravity="center"
            android:id="@+id/btnSubmit"
            android:background="@drawable/bg_earn_withdraw_submit_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/earn_withdraw_submit"
            android:fontFamily="sans-serif-medium"/>
    </FrameLayout>
</LinearLayout>
