<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ar_collect_root"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.xhey.embodied.preview.HandOverlayView
        android:id="@+id/hand_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="12sp"
        android:textColor="#00ff00"
        android:layout_gravity="start|top"
        android:id="@+id/tv_debug_info"
        android:background="#88000000"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/pb_collect_loading"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/embodied_loading_ring"
        android:indeterminateDuration="800"
        android:contentDescription="@string/embodied_status_preparing"/>
    <FrameLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_hand_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080426"
            android:scaleType="fitCenter"
            android:contentDescription="@string/embodied_hand_guide_desc"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="start|top"
            android:orientation="horizontal"
            android:id="@+id/ll_capture_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/embodied_capture_back"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="16dp">
            <TextView
                android:textSize="30sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/embodied_capture_back"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="end|top"
            android:orientation="horizontal"
            android:id="@+id/ll_duration_pill"
            android:background="@drawable/embodied_capsule_dark"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="16dp">
            <View
                android:id="@+id/v_duration_dot"
                android:background="@drawable/embodied_dot_idle_gray"
                android:layout_width="8dp"
                android:layout_height="8dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="#ffffff"
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/embodied_duration_zero"
                android:includeFontPadding="false"
                android:fontFamily="monospace"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:layout_gravity="top|center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_state_banner"
            android:background="@drawable/embodied_state_banner_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="68dp"
            android:minHeight="40dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp">
            <View
                android:id="@+id/v_state_dot"
                android:background="@drawable/embodied_dot_ready"
                android:layout_width="10dp"
                android:layout_height="10dp"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/tv_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/embodied_state_idle"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_record"
            android:visibility="gone"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:src="@drawable/embodied_record_recording"
            android:contentDescription="@string/embodied_record_stop"
            android:layout_marginEnd="32dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:layout_gravity="start|bottom"
            android:id="@+id/tv_disk_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <Button
            android:layout_gravity="end|bottom"
            android:id="@+id/btn_playback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:minWidth="100dp"
            android:text="@string/embodied_open_player"
            android:layout_marginEnd="16dp"/>
    </FrameLayout>
</FrameLayout>
