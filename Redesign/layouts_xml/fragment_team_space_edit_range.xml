<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_radius_12_top_f5f5f5"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/dp_16">
    <com.xhey.xcamera.uikit.view.AutoDirectionEditTextView
        android:textSize="@dimen/textSize18sp"
        android:textColor="@color/text_ultrastrong"
        android:gravity="center"
        android:id="@+id/etLocationRange"
        android:background="@drawable/bg_radius_5_dedede_1dp"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginBottom="@dimen/dp_16"
        android:maxLength="20"
        android:inputType="textMultiLine"
        android:layout_marginStart="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/tvEnterHint"
        app:layout_constraintEnd_toStartOf="@+id/llRangeOption"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/llRangeOption"
        android:background="@drawable/bg_radius_4_dedede_1dp"
        android:padding="@dimen/dp_2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_44"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/etLocationRange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/etLocationRange"
        app:layout_constraintTop_toTopOf="@+id/etLocationRange">
        <Button
            android:textColor="@drawable/text_selector"
            android:id="@+id/btn_mi"
            android:background="@drawable/button_item_selector"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_40"
            android:text="mi"
            android:textAllCaps="false"/>
        <Button
            android:textColor="@drawable/text_selector"
            android:id="@+id/btn_km"
            android:background="@drawable/button_item_selector"
            android:layout_width="@dimen/dp_46"
            android:layout_height="@dimen/dp_40"
            android:text="km"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/dp_2"/>
    </LinearLayout>
    <com.xhey.xcamera.uikit.view.AutoDirectionTextView
        android:textSize="@dimen/textSize16sp"
        android:textColor="@color/text_weak"
        android:id="@+id/tvEnterHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_27"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/tvDone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/textSize17sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvDone"
        android:background="@drawable/bg_radius_4_0070f4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:text="@string/i_done"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
