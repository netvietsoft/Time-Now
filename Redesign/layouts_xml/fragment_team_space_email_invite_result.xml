<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:background="#f1f1f1"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:leftAction="back"
        app:title="@string/i_add_mambers"/>
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp_28"
        android:layout_height="@dimen/dp_28"
        android:layout_marginTop="@dimen/dp_8"
        android:src="@drawable/global_border_close_ultrastrong"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/navigationBar"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivResult"
                android:layout_width="@dimen/dp_84"
                android:layout_height="@dimen/dp_84"
                android:layout_marginTop="@dimen/dp_80"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/textSize20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivResult"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clSuccess"
                android:background="@drawable/bg_radius_5_ebf3fa"
                android:padding="@dimen/dp_16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_114"
                android:layout_marginHorizontal="@dimen/dp_24"
                app:layout_constraintTop_toBottomOf="@+id/tvResult">
                <com.xhey.xcamera.uikit.view.AutoDirectionTextView
                    android:textSize="@dimen/textSize18sp"
                    android:textColor="@color/black"
                    android:id="@+id/tvSuccessTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/dp_2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/textSize14sp"
                    android:textColor="#5c7899"
                    android:id="@+id/tvExpireTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvSuccessTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clFail"
                android:background="@drawable/bg_radius_5_f5f5f5"
                android:paddingBottom="@dimen/dp_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginHorizontal="@dimen/dp_24"
                app:layout_constraintTop_toBottomOf="@+id/clSuccess"
                app:layout_goneMarginTop="@dimen/dp_114">
                <com.xhey.xcamera.uikit.view.AutoDirectionTextView
                    android:textSize="@dimen/textSize18sp"
                    android:textColor="@color/color_333333"
                    android:id="@+id/tvFailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_radius_5_white_new"
                    android:paddingBottom="@dimen/dp_24"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_2"
                    android:paddingHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tvFailTitle">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/textSize14sp"
                        android:textColor="@color/color_EA4D3D"
                        android:id="@+id/tvInvalidEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/i_invalid_email_address"/>
                    <com.xhey.xcamera.uikit.view.AutoDirectionTextView
                        android:textSize="@dimen/textSize17sp"
                        android:textColor="@color/text_ultrastrong"
                        android:id="@+id/tvInvalidEmailContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:lineSpacingExtra="@dimen/dp_4"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/textSize14sp"
                        android:textColor="#e59317"
                        android:id="@+id/tvDeliveryIssue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/i_delivery_issue_try_again"/>
                    <com.xhey.xcamera.uikit.view.AutoDirectionTextView
                        android:textSize="@dimen/textSize17sp"
                        android:textColor="@color/text_ultrastrong"
                        android:id="@+id/tvDeliveryIssueContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:lineSpacingExtra="@dimen/dp_4"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="@dimen/textSize14sp"
                        android:textColor="@color/text_medium"
                        android:id="@+id/tvAlreadyMember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_24"
                        android:text="@string/i_already_a_member"/>
                    <com.xhey.xcamera.uikit.view.AutoDirectionTextView
                        android:textSize="@dimen/textSize17sp"
                        android:textColor="@color/text_ultrastrong"
                        android:id="@+id/tvAlreadyMemberContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:lineSpacingExtra="@dimen/dp_4"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="clSuccess,clFail"/>
            <com.xhey.xcamera.uikit.btn.XHeyButton
                android:id="@+id/btnInviteMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginHorizontal="@dimen/dp_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrier"
                app:text="@string/i_invite_more"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
