<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_weak"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btnAction"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_earn_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:minHeight="104dp"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16">
                <com.xhey.xcamera.earn.ui.view.EarnRoundFrameLayout
                    android:id="@+id/coverContainer"
                    android:background="@color/earn_cover_placeholder_dark"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="@dimen/dp_12"
                    app:earnCornerRadius="@dimen/dp_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:id="@+id/ivCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="@null"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ivCoverPlay"
                        android:layout_width="18dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_earn_play_triangle"
                        android:contentDescription="@null"/>
                </com.xhey.xcamera.earn.ui.view.EarnRoundFrameLayout>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/text_ultrastrong"
                    android:ellipsize="end"
                    android:id="@+id/tvPackageSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:minHeight="21dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/coverContainer"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ProgressBar
                    android:id="@+id/settlementProgress"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="11dp"
                    android:max="100"
                    android:progressDrawable="@drawable/bg_earn_upload_progress"
                    app:layout_constraintEnd_toEndOf="@+id/tvPackageSummary"
                    app:layout_constraintStart_toStartOf="@+id/tvPackageSummary"
                    app:layout_constraintTop_toBottomOf="@+id/tvPackageSummary"
                    style="?android:attr/progressBarStyleHorizontal"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/text_ultraweak"
                    android:ellipsize="end"
                    android:id="@+id/tvUploadState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:minHeight="19dp"
                    android:maxLines="2"
                    android:includeFontPadding="false"
                    app:layout_constraintEnd_toEndOf="@+id/tvPackageSummary"
                    app:layout_constraintStart_toStartOf="@+id/tvPackageSummary"
                    app:layout_constraintTop_toBottomOf="@+id/settlementProgress"/>
                <Space
                    android:id="@+id/uploadCardBottomSpace"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="18dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvUploadState"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@drawable/bg_earn_card"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_ultrastrong"
                    android:id="@+id/tvSettlementTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:minHeight="22dp"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_ultraweak"
                    android:id="@+id/tvRecordDurationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/earn_record_total_duration"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/tvRecordDuration"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvSettlementTitle"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_ultrastrong"
                    android:gravity="end"
                    android:id="@+id/tvRecordDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tvRecordDurationLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvRecordDurationLabel"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_ultraweak"
                    android:id="@+id/tvValidDurationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/earn_valid_minutes_client"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/tvValidDuration"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRecordDurationLabel"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_ultrastrong"
                    android:gravity="end"
                    android:id="@+id/tvValidDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tvValidDurationLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvValidDurationLabel"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/text_ultraweak"
                    android:id="@+id/tvRewardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/earn_reward_estimate"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toStartOf="@+id/tvReward"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvValidDurationLabel"/>
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_0070f4"
                    android:gravity="end"
                    android:id="@+id/tvReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintBottom_toBottomOf="@+id/tvRewardLabel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvRewardLabel"/>
                <View
                    android:id="@+id/settlementSeparator"
                    android:background="@color/earn_border_weak"
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRewardLabel"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/text_ultraweak"
                    android:id="@+id/tvSettlementHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:includeFontPadding="false"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_marginEnd="@dimen/dp_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/settlementSeparator"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_0070f4"
                android:gravity="center"
                android:id="@+id/tvReviewState"
                android:background="@drawable/bg_earn_review_state"
                android:paddingTop="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:minWidth="98dp"
                android:minHeight="28dp"
                android:includeFontPadding="false"
                android:paddingStart="@dimen/dp_12"
                android:paddingEnd="@dimen/dp_12"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/reviewDetailCard"
                android:background="@drawable/bg_earn_card"
                android:padding="@dimen/dp_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16">
                <TextView
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textColor="@color/text_ultrastrong"
                    android:id="@+id/tvReviewDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/earn_review_detail"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/text_ultraweak"
                    android:id="@+id/tvReviewDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:includeFontPadding="false"/>
                <com.xhey.xcamera.earn.ui.view.EarnExcludedSegmentsTimelineView
                    android:id="@+id/timelineView"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="43dp"
                    android:layout_marginTop="@dimen/dp_12"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/adviceHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/color_0070f4"
        android:gravity="center"
        android:id="@+id/btnAction"
        android:background="@drawable/bg_earn_ghost_blue_btn"
        android:paddingTop="@dimen/dp_6"
        android:paddingBottom="@dimen/dp_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:minHeight="48dp"
        android:includeFontPadding="false"
        android:paddingStart="@dimen/dp_12"
        android:paddingEnd="@dimen/dp_12"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
