<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#f1f1f1"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vInputMask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:background="#f1f1f1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:leftAction="back"
        app:title="@string/i_add_mambers"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clSelectRole"
        android:background="@drawable/bg_radius_10_white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_52"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/navigationBar">
        <TextView
            android:textSize="@dimen/textSize18"
            android:textColor="@color/text_strong"
            android:gravity="center"
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/i_team_role"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/textSize18"
            android:textColor="@color/text_ultrastrong"
            android:ellipsize="end"
            android:id="@+id/tvSelectRole"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/i_member_default"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:textAlignment="viewEnd"
            android:layout_marginStart="@dimen/dp_12"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ivRoleHint"
            app:layout_constraintStart_toEndOf="@+id/tvRole"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/ivRoleHint"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/ic_forward_ltr"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.xhey.xcamera.uikit.view.AutoDirectionTextView
        android:textSize="@dimen/textSize16sp"
        android:textColor="@color/text_weak"
        android:id="@+id/tvEmailInvite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/i_type_full_email_address_to_invite"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clSelectRole"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clInputEmail"
        android:background="@drawable/bg_radius_10_white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/tvEmailInvite">
        <com.xhey.xcamera.ui.widget.MaxHeightRecyclerView
            android:id="@+id/rvEmailAdded"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toTopOf="@+id/etInputEmail"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:maxHeight="@dimen/dp_120"/>
        <com.xhey.xcamera.uikit.view.AutoDirectionEditTextView
            android:textSize="@dimen/textSize16sp"
            android:textColor="@color/text_ultrastrong"
            android:textColorHint="@color/text_weak"
            android:id="@+id/etInputEmail"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_32"
            android:layout_marginBottom="@dimen/dp_16"
            android:hint="example@mail.com"
            android:inputType="textEmailAddress"
            android:imeOptions="actionDone"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/flSend"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_11"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <com.xhey.xcamera.uikit.btn.XHeyButton
            android:id="@+id/btnSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:text="@string/i_send_with_number"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
