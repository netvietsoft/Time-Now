<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/activityContainer"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_12"
        android:src="@drawable/global_border_close_ultrastrong"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/textSize20"
        android:textStyle="bold"
        android:textColor="@color/text_ultrastrong"
        android:gravity="center"
        android:id="@+id/tvJoinTeam"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_144"
        android:text="@string/i_continue_to_join_team_q"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/textSize28"
        android:textStyle="bold"
        android:textColor="@color/color_0070f4"
        android:gravity="center"
        android:id="@+id/tvTeamName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_20"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvJoinTeam"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContinueWithGoogle"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/clContinueWithMicrosoft">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/textSize18"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvContinueWithGoogle"
            android:background="@drawable/bg_radius_5_0070f4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/i_continue_with_google"
            android:layout_marginHorizontal="@dimen/dp_32"
            android:paddingHorizontal="@dimen/dp_44"/>
        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/google_icon_white"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvContinueWithGoogle"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContinueWithMicrosoft"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/tvContinueWithEmail">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/textSize18"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tvContinueWithMicrosoft"
            android:background="@drawable/bg_radius_5_e3effc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/i_continue_with_microsoft"
            android:layout_marginHorizontal="@dimen/dp_32"
            android:paddingHorizontal="@dimen/dp_44"/>
        <ImageView
            android:layout_width="@dimen/dp_24"
            android:layout_height="@dimen/dp_24"
            android:src="@drawable/microsoft_icon_blue"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tvContinueWithMicrosoft"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/textSize18"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/tvContinueWithEmail"
        android:background="@drawable/bg_radius_5_e3effc"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginBottom="@dimen/dp_34"
        android:text="@string/i_continue_with_email"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:paddingHorizontal="@dimen/dp_44"
        app:layout_constraintBottom_toTopOf="@+id/tvNoThanks"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/textSize18"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvJoin"
        android:background="@drawable/bg_radius_5_0070f4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_45"
        android:layout_marginBottom="@dimen/dp_34"
        android:text="@string/i_join_now"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:paddingHorizontal="@dimen/dp_44"
        app:layout_constraintBottom_toTopOf="@+id/tvNoThanks"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/textSize18"
        android:textColor="@color/text_ultrastrong"
        android:gravity="center"
        android:id="@+id/tvNoThanks"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_70"
        android:text="@string/i_cancel"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
