<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toTopOf="@+id/btnContinue">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dp_24">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12">
                <TextView
                    android:textSize="17sp"
                    android:textColor="#222222"
                    android:id="@+id/tvWorkEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/i_email"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ea4d3d"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:layout_marginStart="@dimen/dp_3"/>
            </LinearLayout>
            <com.xhey.xcamera.uikit.view.AutoDirectionEditTextView
                android:textSize="@dimen/textSize16"
                android:textColor="@color/text_ultrastrong"
                android:textColorHint="@color/text_weak"
                android:id="@+id/etEmail"
                android:background="@drawable/bg_radius_4_dedede_1dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_64"
                android:hint="@string/i_compliance_fill_in_placeholder1"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/dp_12"/>
        </LinearLayout>
    </LinearLayout>
    <com.xhey.xcamera.uikit.btn.XHeyButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_240"
        android:alpha="0.5"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintTop_toTopOf="parent"
        app:text="@string/i_continue_next_step"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_46"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_medium"
            android:id="@+id/tvPrivacyPolicy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/i_privacy_policy"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_ultraweak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" | "/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/text_medium"
            android:id="@+id/tvTermsOfService"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/i_user_agreement"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
