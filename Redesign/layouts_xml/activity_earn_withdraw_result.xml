<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.xhey.xcamera.uikit.nav.NavigationBar
        android:id="@+id/navigationBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">
        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"/>
        <TextView
            android:textSize="20dp"
            android:textColor="@color/text_ultrastrong"
            android:gravity="center"
            android:id="@+id/tvResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="32dp"
            android:textColor="@color/text_ultrastrong"
            android:id="@+id/tvResultAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/earn_ios_text_ultraweak"
            android:gravity="center"
            android:id="@+id/tvResultMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:lineSpacingExtra="3dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/text_white"
        android:gravity="center"
        android:id="@+id/btnDone"
        android:background="@drawable/bg_earn_withdraw_submit_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/earn_withdraw_done"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"/>
</LinearLayout>
